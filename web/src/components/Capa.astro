---
/** Capa da home: mascote, o que é isto, e os números do material. */
import { svgDoQuadro } from '../pixel/computador.js';
import materias from '../materias.json';

// o quadro parado vai no HTML: o mascote aparece mesmo sem JavaScript
const mascote = svgDoQuadro('idle', 0);

const totalMinutos = materias.reduce((s, m) => s + m.minutos, 0);
const totalCapitulos = materias.reduce((s, m) => s + m.capitulos.length, 0);
const horas = Math.floor(totalMinutos / 60);
---

<header class="capa">
  <div class="mascote" data-mascote title="clique para ele ajustar os óculos" set:html={mascote} />

  <div class="texto">
    <p class="sobrescrito">Arquitetura e Desenvolvimento Java · PÓSTECH FIAP</p>
    <h1>Caderno de <span class="px-cromo">anotações</span></h1>
    <p class="chamada">
      O curso inteiro em texto: da JVM ao Quarkus, com os diagramas, as tabelas de
      prova e as pegadinhas que eu errei antes de entender.
    </p>

    <dl class="numeros">
      <div><dt>matérias</dt><dd>{materias.length}</dd></div>
      <div><dt>capítulos</dt><dd>{totalCapitulos}</dd></div>
      <div><dt>de leitura</dt><dd>{horas}h</dd></div>
    </dl>

    <p class="credito">criado por <strong>Gabriel Pinto</strong></p>

    <nav class="acoes">
      <a class="principal" href="#trilha">Seguir a trilha</a>
      <a class="secundaria" href={`${import.meta.env.BASE_URL}indice/`}>Índice completo</a>
    </nav>
  </div>
</header>

<style>
  .capa {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: clamp(1rem, 4vw, 2.5rem);
    align-items: center;
    padding: clamp(1rem, 3vw, 2rem) 0 2rem;
    border-bottom: 1px solid var(--sl-color-hairline);
    margin-bottom: 2.5rem;
  }
  .mascote { cursor: pointer; line-height: 0; }
  .mascote :global(svg),
  .mascote :global(canvas) {
    width: clamp(120px, 17vw, 196px);
    height: auto;
    display: block;
    image-rendering: pixelated;
    filter: drop-shadow(0 7px 0 color-mix(in oklab, var(--sl-color-black) 40%, transparent));
  }
  .sobrescrito {
    font-family: var(--sl-font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
    margin: 0 0 0.4rem;
  }
  h1 {
    font-family: var(--px-display);
    font-variation-settings: 'SOFT' 30, 'opsz' 144;
    font-weight: 600;
    font-size: clamp(2rem, 7vw, 3.4rem);
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin: 0 0 0.6rem;
  }
  .chamada {
    max-width: 46ch;
    color: var(--sl-color-gray-2);
    margin: 0 0 1.2rem;
    text-wrap: pretty;
  }
  .numeros { display: flex; gap: 1.6rem; margin: 0 0 1.4rem; }
  .numeros div { display: flex; flex-direction: column-reverse; }
  .numeros dd {
    margin: 0;
    font-family: var(--px-display);
    font-size: 1.6rem;
    font-weight: 600;
    line-height: 1;
  }
  .numeros dt {
    font-family: var(--sl-font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .credito {
    margin: 0 0 1rem;
    font-family: var(--sl-font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.06em;
    color: var(--sl-color-gray-4);
  }
  .credito strong { color: var(--sl-color-gray-2); font-weight: 600; }
  .acoes { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  .acoes a {
    display: inline-block;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    border: 1px solid var(--sl-color-hairline-light, var(--sl-color-gray-5));
    transition: transform 0.12s ease, background-color 0.12s ease;
  }
  .acoes a:hover { transform: translateY(-1px); }
  .principal { background: var(--sl-color-text); color: var(--sl-color-bg); border-color: transparent; }
  .secundaria { color: var(--sl-color-text); }

  @media (max-width: 52rem) {
    .capa { grid-template-columns: 1fr; justify-items: start; gap: 1rem; }
    .numeros { gap: 1.1rem; }
  }
</style>

<script>
  /* O quadro parado já está no HTML. Com JavaScript, um canvas assume e o
     mascote ganha vida: pisca sozinho e, ao receber um clique, ajusta os
     óculos. Quem pediu menos movimento continua com a figura parada. */
  import { ANIMACOES, LARGURA, ALTURA, corridas, quadro } from '../pixel/computador.js';

  const alvo = document.querySelector<HTMLElement>('[data-mascote]');
  const calmo = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (alvo && !calmo) {
    const ESCALA = 4;
    const canvas = document.createElement('canvas');
    canvas.width = LARGURA * ESCALA;
    canvas.height = ALTURA * ESCALA;
    const ctx = canvas.getContext('2d')!;

    // desenha cada quadro uma vez e guarda as corridas (não recalcula depois)
    const cache = new Map<string, ReturnType<typeof corridas>>();
    const corridasDe = (anim: string, i: number) => {
      const chave = `${anim}:${i}`;
      if (!cache.has(chave)) cache.set(chave, corridas(quadro(anim, i)));
      return cache.get(chave)!;
    };

    let animacao = 'idle';
    let indice = 0;

    const desenhar = () => {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      for (const [x, y, w, cor] of corridasDe(animacao, indice)) {
        ctx.fillStyle = cor as string;
        ctx.fillRect(x * ESCALA, y * ESCALA, w * ESCALA, ESCALA);
      }
    };

    const avancar = () => {
      const total = ANIMACOES[animacao].length;
      indice = (indice + 1) % total;
      // a sequência dos óculos roda uma vez e volta ao repouso
      if (animacao === 'ajustar_oculos' && indice === 0) animacao = 'idle';
      desenhar();
    };

    alvo.replaceChildren(canvas);
    desenhar();

    let relogio = setInterval(avancar, 1000 / 7);
    addEventListener('visibilitychange', () => {
      clearInterval(relogio);
      if (!document.hidden) relogio = setInterval(avancar, 1000 / 7);
    });

    alvo.addEventListener('click', () => {
      animacao = 'ajustar_oculos';
      indice = 0;
      desenhar();
    });
  }
</script>
