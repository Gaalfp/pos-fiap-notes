---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>

<script>
  /* Diagramas: vêm desenhados do build (tools/renderizar-diagramas.mjs).
     O Mermaid só é baixado se sobrar algum bloco sem SVG — o que evita
     ~5 MB de JavaScript no caso normal. */
  const pendentes = document.querySelectorAll('pre.mermaid');
  if (pendentes.length) {
    const { default: mermaid } = await import('mermaid');
    const escuro = document.documentElement.dataset.theme !== 'light';
    mermaid.initialize({
      startOnLoad: false,
      theme: escuro ? 'dark' : 'default',
      fontFamily: "'Figtree Variable', system-ui, sans-serif",
      flowchart: { useMaxWidth: true, htmlLabels: true },
      sequence: { useMaxWidth: true },
    });
    await mermaid.run({ nodes: [...pendentes] as HTMLElement[] });
  }

  /* Animações: cada uma é um módulo próprio, baixado só na página que a usa.
     O marcador <!--animacao: nome--> do markdown virou <div data-animacao>. */
  for (const alvo of document.querySelectorAll<HTMLElement>('[data-animacao]')) {
    const nome = alvo.dataset.animacao!;
    try {
      const modulo = await import(`../animacoes/${nome}.js`);
      modulo.montar(alvo);
    } catch (erro) {
      console.warn(`[animacao] "${nome}" não pôde ser carregada`, erro);
      alvo.remove();   // sem animação, a página segue como texto
    }
  }
</script>
