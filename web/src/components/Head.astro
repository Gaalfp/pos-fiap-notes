---
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default><slot /></Default>

<script>
  /* Os diagramas vêm desenhados do build (tools/renderizar-diagramas.mjs).
     O Mermaid só é baixado se sobrar algum bloco não renderizado — o que
     evita ~5 MB de JavaScript no caso normal. */
  const pendentes = document.querySelectorAll('pre.mermaid');
  if (pendentes.length) {
    const { default: mermaid } = await import('mermaid');
    const escuro = document.documentElement.dataset.theme !== 'light';
    mermaid.initialize({
      startOnLoad: false,
      theme: escuro ? 'dark' : 'default',
      fontFamily: "'Figtree Variable', system-ui, sans-serif",
      flowchart: { useMaxWidth: true, htmlLabels: true },
      sequence: { useMaxWidth: true },
    });
    await mermaid.run({ nodes: [...pendentes] as HTMLElement[] });
  }
</script>
