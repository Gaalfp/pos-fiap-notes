---
/** A ordem de leitura recomendada, com marcação do que já foi lido. */
import materias from '../materias.json';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const passos = materias
  .filter((m) => m.trilha)
  .sort((a, b) => a.trilha - b.trilha);
---

<section id="trilha" class="trilha">
  <header>
    <h2>A trilha</h2>
    <p>
      Da plataforma que executa tudo até a alternativa ao Spring. Não é obrigatório
      ler nesta ordem — mas cada matéria supõe as anteriores.
    </p>
  </header>

  <ol>
    {passos.map((m) => (
      <li data-url={`${base}${m.url}`}>
        <a href={`${base}${m.url}`}>
          <span class="n">{String(m.trilha).padStart(2, '0')}</span>
          <span class="corpo">
            <strong>{m.nome}</strong>
            <small>{m.descricao}</small>
          </span>
          <span class="tempo">{m.minutos} min</span>
        </a>
      </li>
    ))}
  </ol>
</section>

<style>
  .trilha { margin: 0 0 3rem; }
  .trilha h2, .trilha :global(h2) {
    font-family: var(--px-display);
    font-size: 1.8rem;
    margin: 0 0 0.3rem;
    border: none;
  }
  .trilha > header p { color: var(--sl-color-gray-3); margin: 0 0 1.2rem; max-width: 56ch; }

  ol { list-style: none; margin: 0; padding: 0; position: relative; }
  /* o fio que liga os passos */
  ol::before {
    content: '';
    position: absolute;
    left: 1.05rem;
    top: 0.9rem;
    bottom: 0.9rem;
    width: 1px;
    background: var(--sl-color-hairline);
  }
  li { position: relative; }
  li a {
    display: grid;
    grid-template-columns: 2.1rem 1fr auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.5rem 0.6rem 0.5rem 0;
    text-decoration: none;
    color: inherit;
    border-radius: 8px;
  }
  li a:hover { background: color-mix(in oklab, var(--sl-color-gray-6) 70%, transparent); }

  .n {
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 50%;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline-light, var(--sl-color-gray-5));
    font-family: var(--sl-font-mono);
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }
  .corpo { display: flex; flex-direction: column; min-width: 0; }
  .corpo strong { font-size: 0.98rem; line-height: 1.25; }
  .corpo small {
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
    line-height: 1.3;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }
  .tempo {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    color: var(--sl-color-gray-4);
    white-space: nowrap;
  }

  /* estado "lido", aplicado pelo script de progresso */
  li[data-lido] .n {
    background: var(--sl-color-text);
    color: var(--sl-color-bg);
    border-color: transparent;
  }
  li[data-lido] .n::after { content: '✓'; font-size: 0.9rem; }
  li[data-lido] .n :global(*) { display: none; }
  li[data-lido] .corpo strong { color: var(--sl-color-gray-3); }

  @media (max-width: 40rem) {
    .corpo small { display: none; }
  }
</style>
