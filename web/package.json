    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "astro": "^7.4.8",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "playwright": "^1.65.0"
  }
}
